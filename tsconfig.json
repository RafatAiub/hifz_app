{
    "extends":  "expo/tsconfig.base",
    "compilerOptions":  {
                            "strict":  true,
                            "noUncheckedIndexedAccess":  true,
                            "noImplicitOverride":  true,
                            "baseUrl":  ".",
                            "paths":  {
                                          "@/*":  [
                                                      "src/*"
                                                  ]
                                      },
                            "ignoreDeprecations":  "6.0"
                        },
    "include":  [
                    "src/**/*.ts",
                    "src/**/*.tsx",
                    ".expo/types/**/*.ts",
                    "expo-env.d.ts"
                ]
}